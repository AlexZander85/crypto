// Конфигурация Cloudflare Worker «КриптоНавигатор SaaS»
// Деплой: npx wrangler deploy   (секреты: npx wrangler secret put JWT_SECRET и т.д.)
// Локально: npx wrangler dev    (D1/KV/R2 симулируются локально)
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cryptonavigator-api",
  "main": "src/index.js",
  "compatibility_date": "2026-08-01",
  "account_id": "ac2b178b7823f4971ec5d451e95129ad",

  "d1_databases": [
    { "binding": "DB", "database_name": "cn", "database_id": "f4b86f73-baa7-46a1-a6b4-e5687deacc19" }
  ],
  "kv_namespaces": [
    { "binding": "KV", "id": "155c0fded467455ba7baa0f0f48d982f" }
  ],
  "r2_buckets": [
    { "binding": "PACKS", "bucket_name": "cn-packs" }
  ],

  // Workers AI — наставник (§10). Бесплатный тариф: 10 000 нейронов/день.
  "ai": { "binding": "AI" },

  // Статика SaaS-версии приложения (public/index.html = сборка из index_v9.html + integration.js).
  // Assets отдаются напрямую; /api/* уходит в воркер.
  "assets": { "directory": "./public", "binding": "ASSETS" },

  // НЕ секретные настройки. Секреты — через `wrangler secret put`:
  //   JWT_SECRET, ADMIN_SECRET (залиты), RESEND_API_KEY, LS_SIGNING_SECRET,
  //   YOOKASSA_WEBHOOK_SECRET, TURNSTILE_SECRET, OAUTH_*, YOOKASSA_*, CRYPTOMUS_*
  // ВАЖНО: секреты НЕ дублировать в vars — иначе API откажет (code 10053 «already in use»).
  "vars": {
    "ENV": "dev",
    // Отправитель писем magic-link (Resend). Заработает после верификации домена cryptonavigator.app в Resend;
    // до этого письма с этого адреса отклоняются — фронт честно показывает fallback (dev_link / Google).
    "MAIL_FROM": "КриптоНавигатор <noreply@cryptonavigator.app>",
    "ALLOWED_ORIGIN": "*",
    "APP_ORIGIN": "https://cryptonavigator.app",
    "JWT_TTL_SECONDS": "2592000",
    // Cryptomus: MERCHANT_ID пуст → создание инвойса честно отвечает 501 (платежи позже).
    "CRYPTO_PRICE_JSON": "{\"lite\":{\"amount\":\"12.00\",\"currency\":\"USD\"},\"pro\":{\"amount\":\"24.00\",\"currency\":\"USD\"},\"max\":{\"amount\":\"3.99\",\"currency\":\"USD\"}}",
    "LS_TIER_MAP": "{}",
    "YK_TIER_MAP": "{}",
    // Витрина тарифов для /api/pay/prices (§9: цены только в конфиге). На проде —
    // через `npx wrangler secret put PRICES_JSON` или vars в дашборде.
    "PRICES_JSON": "{\"lite\":{\"title\":\"🔑 Лайт\",\"price\":\"990 ₽ · $12 навсегда\",\"note\":\"все 213 уроков\",\"amount_rub\":\"990\",\"pay\":{\"yookassa\":true,\"lemonsqueezy\":true,\"crypto\":true}},\"pro\":{\"title\":\"📊 Про\",\"price\":\"1 990 ₽ · $24 навсегда\",\"note\":\"+ 🌍 живой рынок\",\"amount_rub\":\"1990\",\"pay\":{\"yookassa\":true,\"lemonsqueezy\":true,\"crypto\":true}},\"max\":{\"title\":\"🤖 Макс\",\"price\":\"399 ₽/мес · $24/год\",\"note\":\"+ 🤖 наставник 100/день и RAG\",\"amount_rub\":\"399\",\"pay\":{\"yookassa\":true,\"crypto\":true}}}",
    // Даунгрейд после истечения подписки «Макс» (§9): free | lite | pro
    "TIER_DOWNGRADE": "free",
    // Дневной лимит нейронов Workers AI (дашборд «Нейроны» в админке). Workers Free = 10 000/день.
    "NEURON_DAILY_LIMIT": "10000"
  },

  // cron 03:00 UTC (§12.2): свёртка телеметрии в stats_daily + чистка events > 180 дней
  "triggers": { "crons": ["0 3 * * *"] },

  "observability": { "enabled": true }
}
